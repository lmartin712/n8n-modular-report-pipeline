        "height": 200,
        "color": 7
      }
    },
    {
      "name": "Sáv fo",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -150
      ],
      "parameters": {
        "content": "### 1 · Request intake → company selection\nReads the control sheet, runs the prerequisite sub-workflow, takes a run lock, reads the client register",
        "width": 3180,
        "height": 330,
        "color": 7
      }
    },
    {
      "name": "Sáv ber",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        310
      ],
      "parameters": {
        "content": "### 2 · Payroll loop\nLock → loop per company → **Report package: Payroll** (sub-workflow) → summary → write-back → log",
        "width": 3180,
        "height": 530,
        "color": 7
      }
    },
    {
      "name": "Sáv afa",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
